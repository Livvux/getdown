# Single-instance, self-hosted Next.js application.
YT_DLP_BIN=yt-dlp
# Production uses the isolated egress proxy from compose.dokploy.yaml.
YT_DLP_PROXY=
DOWNLOAD_DIR=/data/downloads
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_DOWNLOADS=12
MAX_FILE_MB=500
MAX_DURATION_SECONDS=7200
JOB_TIMEOUT_SECONDS=1800
FILE_TTL_MINUTES=60

# Set to 1 ONLY when requests pass through a trusted proxy that replaces
# X-Forwarded-For / CF-Connecting-IP. Otherwise a shared global limiter is used.
TRUST_PROXY_HEADERS=0

# Optional additional PUBLIC domain names, comma-separated (avoid internal hosts).
ADDITIONAL_ALLOWED_HOSTS=
